{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-list-classes",
    "allow-list-audio-devices",
    "allow-discover-teachers",
    "allow-capture-screen-preview",
    "allow-start-teacher-session",
    "allow-stop-teacher-session",
    "allow-start-student-mic-meter",
    "allow-stop-student-mic-meter",
    "allow-start-screen-demo",
    "allow-stop-screen-demo",
    "allow-start-own-screen-demo",
    "allow-stop-own-screen-demo",
    "allow-start-mic-broadcast",
    "allow-stop-mic-broadcast",
    "allow-start-listen",
    "allow-stop-listen",
    "allow-start-intercom",
    "allow-stop-intercom",
    "allow-create-group",
    "allow-leave-group",
    "allow-connect-student-session",
    "allow-disconnect-student-session"
  ]
